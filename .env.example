# Tu clave de la Steam Web API (32 caracteres hexadecimales).
# Puedes obtenerla gratis en: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# URL base de la aplicación (para desarrollo local usa http://localhost:8000)
STEAM_REALM=http://localhost:8000

# Secreto criptográfico para firmar cookies de sesión segura
SECRET_KEY=steam_calendar_super_secret_key_change_me_in_production_12345

# Tiempo de vida de la caché de lanzamientos en horas (por defecto 6 horas)
CACHE_TTL_HOURS=6

# Nivel de registro (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO